<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/rivune_primary</item>
        <item name="android:windowBackground">@color/rivune_midnight</item>
        <item name="android:statusBarColor">@color/rivune_midnight</item>
        <item name="android:navigationBarColor">@color/rivune_midnight</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/rivune_midnight</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/rivune_splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
